{
  "name": "aida",
  "version": "0.0.1",
  "description": "aida engine: capture, voice, render and build a self-updating help app from walkthrough files.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "aida": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -b && node -e \"const fs=require('fs');for(const f of ['frame-diff-worker.mjs','png-diff-core.mjs'])fs.copyFileSync('src/capture/'+f,'dist/capture/'+f)\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "schema:gen": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.1.0",
    "ffmpeg-static": "^5.2.0",
    "kokoro-js": "^1.2.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
