{
  "name": "aida-docs",
  "version": "0.0.1",
  "description": "AIDA engine: turns walkthrough files into a help site with printable pages, narrated videos, a help chat and an agent connector, kept current from CI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryaida/aida.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/tryaida/aida#readme",
  "bugs": {
    "url": "https://github.com/tryaida/aida/issues"
  },
  "keywords": [
    "documentation",
    "user-guide",
    "help-center",
    "tutorial-video",
    "walkthrough",
    "playwright",
    "nextjs",
    "mcp"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aida": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "assets",
    "src/init/templates"
  ],
  "scripts": {
    "build": "tsc -b && node -e \"const fs=require('fs');for(const f of ['frame-diff-worker.mjs','png-diff-core.mjs'])fs.copyFileSync('src/capture/'+f,'dist/capture/'+f)\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "schema:gen": "tsx scripts/generate-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.1.0",
    "ffmpeg-static": "^5.2.0",
    "kokoro-js": "^1.2.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "yaml": "^2.6.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "typescript": "^5.7.3"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
